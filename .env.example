# ---------------------------------------------------------------------------------------
# simpl-ovh-mcp configuration. Copy to .env for local use; set the same names as Railway
# variables in production. Nothing here has a sensible default that involves a credential.
# ---------------------------------------------------------------------------------------

# --- OVHcloud API ----------------------------------------------------------------------
# Either the classic triplet (create at https://api.ovh.com/createToken/ with rights on
# GET/POST/PUT/DELETE /cloud/* and /domain/*) …
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# … or an OAuth2 service account, which OVH now recommends. If both are set, this one wins.
OVH_CLIENT_ID=
OVH_CLIENT_SECRET=
# The Public Cloud project the cluster lives in (ovh_projects_list shows them).
OVH_CLOUD_PROJECT=

# --- Permissions -----------------------------------------------------------------------
# readonly: inspect only. operate: create and change. admin: also destroy.
SIMPL_MCP_MODE=operate
# Destructive tools additionally need this. Two switches, on purpose.
SIMPL_MCP_ALLOW_DESTRUCTIVE=false
# Narrow the tool surface if a client's context budget is tight.
# SIMPL_MCP_TOOL_GROUPS=meta,ovh,k8s,helm,argocd,simpl,bridge

# --- Transport -------------------------------------------------------------------------
# stdio for a local client (Claude Code, Claude Desktop); http for a hosted deployment.
SIMPL_MCP_TRANSPORT=stdio
SIMPL_MCP_PATH=/mcp
# Required for http when the mode is not readonly.
SIMPL_MCP_BEARER_TOKEN=
# Behind a proxy (Railway), name the public host or the DNS-rebinding guard rejects requests.
# SIMPL_MCP_ALLOWED_HOSTS=simpl-mcp.up.railway.app

# --- Kubernetes ------------------------------------------------------------------------
# Optional. A cluster created through this server stores its own credentials per profile;
# set one of these to point the server at a cluster it did not create — a local k3d, say.
# SIMPL_MCP_KUBECONFIG=/home/you/.kube/config
# SIMPL_MCP_KUBECONFIG_B64=

# --- Bridge ----------------------------------------------------------------------------
# The vendored chart ships in the image; override to deploy from a working copy.
# BRIDGE_CHART_PATH=/app/vendor/charts/bridge
BRIDGE_IMAGE_REGISTRY=
BRIDGE_IMAGE_REPOSITORY=simpl-open/bridge
BRIDGE_IMAGE_TAG=
DOME_BASE_URL=https://tmf.sbx.evidenceledger.eu/tmf-api/productCatalogManagement

# --- Housekeeping ----------------------------------------------------------------------
# Profiles, kubeconfigs and the audit log. Mount a Railway volume here.
SIMPL_MCP_STATE_DIR=/data
# ARGOCD_NAMESPACE=argocd
# ARGOCD_AUTH_TOKEN=          # only if the initial admin secret has been deleted
